#pragma once

// Copy this file to secrets.h and replace the three placeholders locally.
// Never commit secrets.h.
constexpr char WIFI_SSID[] = "YOUR_WIFI_NAME";
constexpr char WIFI_PASSWORD[] = "YOUR_WIFI_PASSWORD";

// For local development, use your computer's LAN IPv4 address, not 127.0.0.1.
// Example: http://192.168.1.50:5000
constexpr char API_BASE_URL[] = "http://YOUR_COMPUTER_LAN_IP:5000";

// Must match IOT_API_KEY in backend/.env exactly.
constexpr char IOT_API_KEY[] = "YOUR_LONG_RANDOM_IOT_KEY";
