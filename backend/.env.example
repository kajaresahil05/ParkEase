# Copy this file to .env for local development. Do not commit .env.
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value

# Use a full SQLAlchemy URL when Railway provides one.
# DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME

# Or provide the individual MySQL settings instead.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=parkease
MYSQL_USER=parkease_app
MYSQL_PASSWORD=replace-me

# Shared only between Flask and the ESP32. Generate a long random value locally.
IOT_API_KEY=replace-with-a-long-random-value

# Comma-separated origins allowed to call the API. Set this to the deployed
# Vercel URL in production.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
